# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files stay LOCAL ONLY — a committed bot token was leaked via GitHub
# and auto-revoked by Discord on 2026-08-24. Never re-add these.
.env*

# local-only media: discord-imported gallery items & runtime uploads
/public/media/discord-*
/data/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite transient files
/data/tickets.db-shm
/data/tickets.db-wal

# kill-switch runtime state (contains the wipe token)
/scripts/.killswitch-state.json


# unreferenced local dump folder (338MB duplicates)
/Gallery files/

